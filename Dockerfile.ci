# syntax=docker/dockerfile:1
FROM rust:1.94.0-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        curl \
        ffmpeg \
        file \
        git \
        lld \
        make \
        pkg-config \
        tar \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG CARGO_NEXTEST_VERSION=0.9.138
ARG CARGO_NEXTEST_SHA256=3793bf0c27607b196f502c39b2108f571de89fcda7586ae6beefa11ee177b216
RUN curl -LsSf "https://get.nexte.st/${CARGO_NEXTEST_VERSION}/linux" -o /tmp/cargo-nextest.tar.gz \
    && echo "${CARGO_NEXTEST_SHA256}  /tmp/cargo-nextest.tar.gz" | sha256sum --check \
    && tar zxf /tmp/cargo-nextest.tar.gz -C /usr/local/cargo/bin \
    && rm /tmp/cargo-nextest.tar.gz

WORKDIR /workspace/vigil
