# syntax=docker/dockerfile:1
# Hardware images build from an explicitly filtered context containing the
# Vigil, Context Graph, and ContextDB source trees. They are intentionally
# separate from the static image so a local acceptance build never parses or
# uploads these source-building stages.
FROM rust:alpine3.22 AS vigil-hw-builder-amd64
RUN apk add --no-cache build-base pkgconf gstreamer-dev gst-plugins-base-dev
COPY vigil/ /workspace/vigil-src/
COPY context-graph/ /workspace/context-graph/
COPY contextdb/ /workspace/contextdb/
WORKDIR /workspace/vigil-src
RUN mv .cargo/config.toml /tmp/vigil-cargo-cross-config.toml
ENV RUSTFLAGS="-C target-feature=-crt-static"
RUN cargo build --release -p vigil-bin --bin vigil --features decode-gstreamer,detect-burn-wgpu,fabric --locked

# Exact binary hand-off shared by every amd64 production image and by CI's raw
# binary artifact. No release image may source a different, externally staged
# `vigil` file.
FROM scratch AS vigil-hw-binary-amd64
COPY --from=vigil-hw-builder-amd64 /workspace/vigil-src/target/release/vigil /vigil

FROM alpine:3.22 AS vigil-generic-docker-hw-amd64
RUN apk add --no-cache \
    gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad gst-vaapi \
    libva libva-intel-driver intel-media-driver mesa-va-gallium \
    vulkan-loader mesa-vulkan-intel mesa-vulkan-ati
COPY --from=vigil-hw-binary-amd64 /vigil /usr/local/bin/vigil
LABEL vigil.artifact="vigil-generic-docker-hw-amd64" \
      vigil.arch="amd64" \
      vigil.decode_backend="gstreamer" \
      vigil.detector_backend="burn-wgpu" \
      vigil.fabric="enabled"
ENV VIGIL_DATA_DIR=/data
ENV VIGIL_DROP_PRIVILEGES=1
ENV VIGIL_RUN_UID=1000
ENV VIGIL_RUN_GID=1000
EXPOSE 8099 8098
CMD ["/usr/local/bin/vigil", "run"]

FROM ghcr.io/home-assistant/base:3.22 AS vigil-addon-hw-amd64
ARG BUILD_VERSION=0.1.0
RUN apk add --no-cache \
    gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad gst-vaapi \
    libva libva-intel-driver intel-media-driver mesa-va-gallium \
    vulkan-loader mesa-vulkan-intel mesa-vulkan-ati
COPY --from=vigil-hw-binary-amd64 /vigil /usr/local/bin/vigil
LABEL io.hass.arch="amd64" \
      io.hass.type="app" \
      io.hass.version="${BUILD_VERSION}" \
      vigil.artifact="vigil-addon-hw-amd64" \
      vigil.arch="amd64" \
      vigil.decode_backend="gstreamer" \
      vigil.detector_backend="burn-wgpu" \
      vigil.fabric="enabled"
ENV S6_KEEP_ENV=1
ENV VIGIL_DATA_DIR=/data
ENV VIGIL_DROP_PRIVILEGES=1
ENV VIGIL_RUN_UID=1000
ENV VIGIL_RUN_GID=1000
EXPOSE 8099 8098
CMD ["/usr/local/bin/vigil", "run"]

