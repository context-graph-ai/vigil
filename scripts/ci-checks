#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
case "${1:-}" in
  --help|-h) echo 'usage: scripts/ci-checks [--portable] (PR checks; full mode requires the public exact siblings)'; exit 0 ;;
  --portable) exec ./scripts/ci-portable ;;
  '') ;;
  *) echo 'usage: scripts/ci-checks [--portable]' >&2; exit 2 ;;
esac
./scripts/ci-portable
./scripts/ci-public-dependencies check
./scripts/ci-integration --default
